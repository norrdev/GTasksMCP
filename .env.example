# Public HTTPS origin, no trailing slash
PUBLIC_URL=https://mcp.example.com
MCP_DOMAIN=mcp.example.com

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this Google account can use the server
ALLOWED_EMAIL=you@gmail.com

# Optional, comma separated (defaults to Claude's callbacks)
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
PORT=3000
